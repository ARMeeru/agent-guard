# agent-guard editor conventions.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
# Markdown uses two trailing spaces for a hard line break; trimming them
# would silently break rendered output across docs and PR descriptions.
trim_trailing_whitespace = false

[Makefile]
# Recipes require literal tabs; do not normalize.
indent_style = tab
