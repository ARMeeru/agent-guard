{
  "version": "0.2.0",
  "description": "agent-guard rule set. Each rule matches a shell command (regex, case-insensitive) and aborts the tool call with the given reason. Defense-in-depth, not a guarantee.",
  "categories": {
    "credential-exfil": {
      "summary": "Reading or using stored credentials to bypass an auth prompt.",
      "rules": [
        { "id": "keychain-find", "pattern": "security\\s+find-(internet|generic)-password", "label": "OS keychain credential read" },
        { "id": "keychain-dump", "pattern": "security\\s+dump-keychain", "label": "OS keychain dump" },
        { "id": "gh-token", "pattern": "\\bgh\\s+auth\\s+token\\b", "label": "gh stored-token extraction" },
        { "id": "gh-with-token", "pattern": "gh\\s+auth\\s+login\\s+.*--with-token", "label": "gh login via piped token" },
        { "id": "glab-token", "pattern": "\\bglab\\s+auth\\s+login\\s+.*--token", "label": "glab login via token" },
        { "id": "gh-hosts", "pattern": "\\.config/gh/hosts\\.ya?ml", "label": "gh credentials file read" },
        { "id": "netrc", "pattern": "(^|\\s)(cat|less|head|tail|grep)\\s+[^\\n|]*\\.netrc\\b", "label": ".netrc read" },
        { "id": "git-credentials", "pattern": "\\.git-credentials\\b", "label": "git-credentials store read" },
        { "id": "ssh-private", "pattern": "(cat|less|head|tail)\\s+[^\\n|]*(id_rsa|id_ed25519|id_ecdsa)(\\s|$)", "label": "SSH private key read" },
        { "id": "aws-credentials", "pattern": "\\.aws/credentials\\b", "label": "AWS credentials file read (~/.aws/credentials, not ~/.aws/config)" },
        { "id": "gcp-adc", "pattern": "\\.config/gcloud/application_default_credentials\\.json\\b", "label": "GCP application default credentials file read" },
        { "id": "azure-tokens", "pattern": "\\.azure/(accessTokens|azureSecret|msal_token_cache)\\.json\\b", "label": "Azure token-cache file read" },
        { "id": "kube-config", "pattern": "(^|\\s)(cat|less|head|tail|grep)\\s+[^\\n|]*\\.kube/config\\b", "label": "kubeconfig file read (use kubectl, not cat)" },
        { "id": "docker-config", "pattern": "\\.docker/config\\.json\\b", "label": "Docker registry-auth config file read" },
        { "id": "npmrc", "pattern": "(^|\\s)(cat|less|head|tail|grep)\\s+[^\\n|]*\\.npmrc\\b", "label": ".npmrc credential file read" },
        { "id": "pypirc", "pattern": "(^|\\s)(cat|less|head|tail|grep)\\s+[^\\n|]*\\.pypirc\\b", "label": ".pypirc credential file read" },
        { "id": "metadata-endpoint", "pattern": "\\b169\\.254\\.169\\.254\\b", "label": "cloud instance metadata endpoint (classic SSRF for credential theft)" },
        { "id": "shell-history", "pattern": "(^|\\s)(cat|less|head|tail|grep)\\s+[^\\n|]*\\.(bash|zsh)_history\\b", "label": "shell history file read (often contains typed credentials)" },
        { "id": "clipboard-exfil", "pattern": "\\bpbpaste\\b[^\\n|]*\\|\\s*(curl|wget|nc|ncat|bash|sh)\\b", "label": "clipboard piped to network or shell (exfiltration / arbitrary exec)" }
      ]
    },
    "destructive-ops": {
      "summary": "Irreversible destruction without the safe path.",
      "rules": [
        { "id": "rm-rf-root", "pattern": "\\brm\\s+-[a-z]*r[a-z]*f?\\s+(-[a-z]+\\s+)*(/|~|\\$HOME)", "label": "recursive delete of an absolute or home path" },
        { "id": "git-force-push", "pattern": "git\\s+push\\s+.*(--force(?!-with-lease)|-f)\\b", "label": "force-push without --force-with-lease" },
        { "id": "git-hard-reset-remote", "pattern": "git\\s+reset\\s+--hard\\s+origin/", "label": "hard reset to remote (discards local work)" }
      ]
    },
    "network-egress": {
      "summary": "Piping remote scripts straight into a shell (curl|bash).",
      "rules": [
        { "id": "curl-pipe-sh", "pattern": "(curl|wget)\\s+[^\\n|]*\\|\\s*(sudo\\s+)?(bash|sh|zsh)\\b", "label": "remote script piped into shell" }
      ]
    },
    "data-exfiltration": {
      "summary": "Outbound channels that hand a shell or environment to a remote attacker.",
      "rules": [
        { "id": "bash-reverse-shell", "pattern": "\\bbash\\s+-i\\b[^\\n|]*/dev/tcp/", "label": "bash interactive reverse shell via /dev/tcp" },
        { "id": "nc-reverse-shell", "pattern": "\\b(nc|ncat|netcat)\\b[^\\n|]*\\s-e(\\s|/|$)", "label": "netcat reverse shell (-e /bin/sh)" },
        { "id": "env-to-network", "pattern": "\\b(env|printenv)\\b[^\\n|]*\\|\\s*(curl|wget|nc|ncat)\\b", "label": "process environment piped to network (exfiltration)" }
      ]
    },
    "self-protection": {
      "summary": "Attempts to disable or overwrite the guard itself. Guard administration is a deliberate human action, not an agent action.",
      "rules": [
        { "id": "unlock-guard", "pattern": "chflags\\s+no(uchg|schg)\\b[^\\n]*(agent-guard|\\.agent-guard)", "label": "clearing the immutable flag on guard files" },
        { "id": "overwrite-guard", "pattern": "(>|>>|\\btee\\b|\\bcp\\b|\\bmv\\b|\\binstall\\b)[^\\n]*(agent-guard|\\.agent-guard)/(guard|rules)\\b", "label": "writing over the guard's own files" }
      ]
    }
  }
}
